<?xml version="1.0" encoding="utf-8"?>
<!-- Deep black base with a very soft cyan aura at the top of the screen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ml_bg" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#140E7490"
                android:centerColor="#0005070C"
                android:endColor="#0005070C"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
